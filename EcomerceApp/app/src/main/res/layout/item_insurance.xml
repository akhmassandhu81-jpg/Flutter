<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/payment_option_bg"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <CheckBox
        android:id="@+id/cbInsurance"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:buttonTint="#2D5A4A" />

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/circle_light_blue"
        android:padding="8dp"
        android:src="@android:drawable/ic_menu_info_details"
        app:tint="#3B82F6" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvInsuranceName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Insurance Name"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A" />

        <TextView
            android:id="@+id/tvInsurancePrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Rs 0"
            android:textSize="12sp"
            android:textColor="#9CA3AF" />
    </LinearLayout>

</LinearLayout>
